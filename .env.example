# Postgres connection string.
DATABASE_URL="postgresql://USER@localhost:5432/emart"

# Auth.js session signing secret. Generate with `openssl rand -base64 32`.
# Required for `next start` outside Vercel. In production, prefer setting
# AUTH_URL="https://your-domain.com" (Auth.js then trusts that host only).
AUTH_TRUST_HOST=true

AUTH_SECRET=""

# Admin account created/updated by `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Optional: test shopper for manual end-to-end checks.
TEST_CUSTOMER_EMAIL=""
TEST_CUSTOMER_PASSWORD=""
